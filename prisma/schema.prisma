datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  Admin
  User
}

enum TransactionStatus {
  Pending
  Completed
  Failed
  Cancelled
  Refunded
}

enum InteractionType {
  click
  view
  add_to_cart
  purchase
}

model User {
  id               String            @id @default(uuid())
  username         String
  email            String            @unique
  password_hash    String
  role             Role              @default(User)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  is_active        Boolean           @default(true)
  
  materials        Material[]        @relation("Provider")
  purchases        Transaction[]     @relation("Buyer")
  sales            Transaction[]     @relation("Seller")
  reviews_written  Review[]          @relation("Reviewer")
  reviews_received Review[]          @relation("ReviewProvider")
  interactions     UserInteraction[]
  material_reviews MaterialReview[]  @relation("MaterialReviewer")
  notifications    Notification[]
  wallet           Wallet?
  tickets          Ticket[]
  ticket_messages  TicketMessage[]
  coupons_created  Coupon[]          @relation("SellerCoupons")

  @@map("users")
}

model Material {
  id          String            @id @default(uuid())
  provider_id String
  title       String
  description String            @db.Text
  file_format String
  file_url    String?
  thumbnail_url String?
  price       Decimal           @db.Decimal(10, 2)
  tags        Json?
  status      String            @default("Approved") // Pending, Approved, Rejected
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  
  provider    User              @relation("Provider", fields: [provider_id], references: [id])
  transactions Transaction[]
  interactions UserInteraction[]
  reviews      MaterialReview[]

  @@map("materials")
}

model Transaction {
  id          String            @id @default(uuid())
  buyer_id    String
  seller_id   String
  material_id String
  amount      Decimal           @db.Decimal(10, 2)
  status      TransactionStatus @default(Pending)
  payment_method String?
  coupon_code    String?
  discount_amount Decimal?          @db.Decimal(10, 2)
  created_at  DateTime          @default(now())
  
  buyer       User              @relation("Buyer", fields: [buyer_id], references: [id])
  seller      User              @relation("Seller", fields: [seller_id], references: [id])
  material    Material          @relation(fields: [material_id], references: [id])

  @@map("transactions")
}

model Review {
  id          String   @id @default(uuid())
  reviewer_id String
  provider_id String
  rating      Int      @default(5)
  comment     String?  @db.Text
  created_at  DateTime @default(now())
  
  reviewer    User     @relation("Reviewer", fields: [reviewer_id], references: [id])
  provider    User     @relation("ReviewProvider", fields: [provider_id], references: [id])

  @@map("reviews")
}

model UserInteraction {
  id               String          @id @default(uuid())
  user_id          String
  material_id      String
  interaction_type InteractionType
  created_at       DateTime        @default(now())
  
  user             User            @relation(fields: [user_id], references: [id])
  material         Material        @relation(fields: [material_id], references: [id])

  @@map("user_interactions")
}

model MaterialReview {
  id          String   @id @default(uuid())
  user_id     String
  material_id String
  rating      Int      @default(5)
  comment     String?  @db.Text
  seller_reply String? @db.Text
  replied_at  DateTime?
  created_at  DateTime @default(now())
  
  user        User     @relation("MaterialReviewer", fields: [user_id], references: [id])
  material    Material @relation(fields: [material_id], references: [id])
  
  @@unique([user_id, material_id])
  @@map("material_reviews")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String   @db.Text
  is_read    Boolean  @default(false)
  link       String?
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Wallet {
  id         String   @id @default(uuid())
  user_id    String   @unique
  balance    Decimal  @db.Decimal(15, 2) @default(0.00)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id         String   @id @default(uuid())
  wallet_id  String
  type       String   // "DEPOSIT", "WITHDRAWAL", "PAYMENT", "EARNING"
  amount     Decimal  @db.Decimal(15, 2)
  status     String   @default("Completed") // "Pending", "Completed", "Failed"
  description String?
  created_at DateTime @default(now())

  wallet     Wallet   @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

model Ticket {
  id          String         @id @default(uuid())
  user_id     String
  subject     String
  description String         @db.Text
  status      TicketStatus   @default(Open)
  category    String?        // Phân loại tự động bởi AI (Vd: Thanh toán, Kỹ thuật...)
  ai_suggested_reply String? @db.Text // AI gợi ý câu trả lời
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  user        User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages    TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticket_id   String
  sender_id   String
  message     String   @db.Text
  created_at  DateTime @default(now())

  ticket      Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model Coupon {
  id               String    @id @default(uuid())
  code             String    @unique
  seller_id        String
  discount_percent Int
  max_uses         Int       @default(0) // 0 = unlimited
  current_uses     Int       @default(0)
  valid_until      DateTime?
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())

  // Quan hệ
  seller           User      @relation("SellerCoupons", fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("coupons")
}
